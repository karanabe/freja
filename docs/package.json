{
  "name": "freja-docs",
  "version": "0.2.0",
  "private": true,
  "description": "English and Japanese operator and developer documentation for Freja",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev --background",
